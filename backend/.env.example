# ─── Application ──────────────────────────────────────────────
APP_NAME=ASECNA Network API
ENV=development
DEBUG=true

# ─── Base de données MySQL (WampServer par défaut) ──────────────
# Dans WampServer : utilisateur root, pas de mot de passe, port 3306
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=asecna_network

# ─── Sécurité JWT ─────────────────────────────────────────────────
# Générez une vraie valeur en prod, ex: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ─── Clés d'inscription (Login.tsx en mode "Créer un compte") ─────
ADMIN_REGISTRATION_KEY=ASECNA-ADMIN-KEY
TECHNICIEN_VALIDATION_CODE=ASECNA-TECH-2026

# ─── CORS (origines autorisées, séparées par une virgule) ─────────
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
